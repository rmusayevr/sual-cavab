# Copy to backend/.env for local work. Values here are invented local defaults.
# Real environment variables win over this file.

DJANGO_DEBUG=1
# Required when DJANGO_DEBUG is off. Generate one; never commit it.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Frontend origin(s) that POST through the Next.js /api proxy. Defaults to
# localhost:3000 when DJANGO_DEBUG is on.
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000
# Sign-in attempts allowed per account (email).
DJANGO_LOGIN_RATE=10/min
# "Add member" attempts allowed per user (every attempt counts, failures too).
DJANGO_MEMBER_ADD_RATE=30/hour
# Proxies in front that APPEND to X-Forwarded-For. Keep 0 behind Next.js alone:
# Next.js passes a client's own header through, so trusting it is unsafe.
DJANGO_NUM_PROXIES=0

POSTGRES_DB=sual_cavab
POSTGRES_USER=sual_cavab
POSTGRES_PASSWORD=local-dev-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
